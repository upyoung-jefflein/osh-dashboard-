{"name":"農民職業災害保險職業傷病審查辦法","dates":["2018-10-17","2021-09-09","2022-06-24","2023-08-18","2024-08-22","2025-10-01","2026-10-20"],"steps":[{"from":"2024-08-22","to":"2025-10-01","changes":[]},{"from":"2023-08-18","to":"2024-08-22","changes":[{"no":"1","type":"mod","segs":[["=","本辦法依農民健康保險條例第四十四條之二第"],["-","三"],["+","四"],["=","項規定訂定之。"]]}]},{"from":"2022-06-24","to":"2023-08-18","changes":[]},{"from":"2021-09-09","to":"2022-06-24","changes":[]},{"from":"2018-10-17","to":"2021-09-09","changes":[{"no":"9","type":"mod","segs":[["=","被保險人因實際從事農業工作"],["-","，促發農藥中毒、中暑、熱痙攣或熱衰竭者，視"],["+","罹患下列疾病者，"],["=","為職業"],["-","傷害。"],["+","病："]]},{"no":"9-1","type":"add","segs":[["+","被保險人罹患、促發或惡化前條各款以外之疾病，經中央主管機關公告認可醫療機構之職業醫學科專科醫師診斷該疾病與實際從事農業工作有相當因果關係者，視為職業病。"]]}]}]}